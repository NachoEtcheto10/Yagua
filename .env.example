# Yaguá — variables de entorno
# Local: copiá a .env.local (git lo ignora). Producción: cargalas en Vercel -> Settings -> Environment Variables.
# Las de Neon las escribe solo `neon deploy` (o `neon env pull`).

# ── Neon Postgres
DATABASE_URL=""            # con pooler (-pooler): la usa la app
DATABASE_URL_UNPOOLED=""   # directa: la usan las migraciones de Prisma

# ── Neon Object Storage (bucket "assets", para las fotos que se suban desde el admin)
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
AWS_ENDPOINT_URL_S3=""
AWS_REGION=""

# ── Neon (los escribe neon deploy; la app no los usa todavía)
NEON_BRANCH=""
NEON_BRANCH_ID=""
NEON_FUNCTION_HOST_SUFFIX=""
NEON_REALTIME_URL=""
NEON_REALTIME_SECRET=""

# ── Sitio
NEXT_PUBLIC_SITE_URL="http://localhost:3000"   # en producción: https://www.yagua.com.ar

# ── Auth.js
AUTH_SECRET=""             # generar con: npx auth secret
AUTH_GOOGLE_ID=""          # opcional: login con Google (Google Cloud Console -> OAuth)
AUTH_GOOGLE_SECRET=""

# ── Mercado Pago (credenciales de PRUEBA para sandbox: empiezan con TEST-)
MP_ACCESS_TOKEN=""
NEXT_PUBLIC_MP_PUBLIC_KEY=""
MP_WEBHOOK_SECRET=""       # Tus integraciones -> Webhooks -> clave secreta

# ── Seed (npx prisma db seed): usuario admin de la demo
SEED_ADMIN_EMAIL="admin@yagua.com.ar"
SEED_ADMIN_PASSWORD=""
